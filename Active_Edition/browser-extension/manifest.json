{
  "manifest_version": 3,
  "name": "SentinelGuard Active — Browser Protection (Preview)",
  "version": "0.1.0",
  "description": "Optional local browser companion. Blocks exact URL matches from an opt-in phishing feed when paired SentinelGuard Active is ON.",
  "permissions": [
    "storage",
    "alarms",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://openphish.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "SentinelGuard Active"
  },
  "background": {
    "scripts": [
      "background.js"
    ],
    "service_worker": "background.js"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "sentinelguard-active-preview@local.invalid",
      "strict_min_version": "128.0"
    }
  }
}
