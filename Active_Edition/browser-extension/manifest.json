{
  "manifest_version": 3,
  "name": "SentinelGuard 4.1 — Chrome/Edge Web Protection",
  "version": "4.1.0",
  "description": "Optional Chromium companion for SentinelGuard 4.1; blocks opted-in known phishing URLs.",
  "permissions": [
    "storage",
    "alarms",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://openphish.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "SentinelGuard Active"
  },
  "background": {
    "service_worker": "background.js"
  }
}
